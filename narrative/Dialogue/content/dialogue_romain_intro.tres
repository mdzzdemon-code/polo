[sub_resource type="Resource" id="Resource_qqsj6"]
script = ExtResource("1_47ktk")
line_id = &"presence"
speaker = "Romain"
text = "...Rien. Disons simplement qu'il y a des choses anciennes, du côté de la montagne, que je préfère ne pas déranger. Je ne la connais pas. Je sais seulement qu'elle existe."
