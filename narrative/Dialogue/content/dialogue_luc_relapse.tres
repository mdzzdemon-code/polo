[sub_resource type="Resource" id="Resource_2mmpg"]
script = ExtResource("1_qwr44")
line_id = &"relapse"
speaker = "Luc"
text = "...Je ne sais pas ce qui s'est passé cette nuit. Je me suis réveillé avec quelque chose entre les mains qui n'était pas à moi. Un glitch, je crois. Mais essaie d'expliquer ça à quelqu'un qui ne l'a pas vécu."
required_flags = Array[StringName]([])
forbidden_flags = Array[StringName]([])
sets_flags = Array[StringName]([&"event/luc_relapse_confessed"])
grants_item_id = &""
grants_keyword_id = &""
starts_quest_id = &"quest_sauver_luc"
completes_quest_id = &""
triggers_glitch = true
auto_next_line_id = &"relapse_suite"
choices = Array[ExtResource("2_k3iix")]([])

[sub_resource type="Resource" id="Resource_xeavd"]
script = ExtResource("1_qwr44")
line_id = &"relapse_suite"
speaker = "Luc"
text = "Si Romain l'apprend, je suis fini. Pas à cause de ce que j'ai fait — à cause de ce que j'ai été."
