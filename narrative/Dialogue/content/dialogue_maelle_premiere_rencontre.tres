[sub_resource type="Resource" id="Resource_ed1lf"]
script = ExtResource("1_ijmsq")
line_id = &"intro"
speaker = "Maëlle"
text = "Oh ! Je ne m'attendais pas à croiser quelqu'un ici... Tu n'as pas vu un éclat de lumière tomber par ici ? Je le cherche depuis ce matin."
