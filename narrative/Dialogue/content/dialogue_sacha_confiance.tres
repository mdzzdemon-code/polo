[sub_resource type="Resource" id="Resource_ckjhd"]
script = ExtResource("1_dn25p")
line_id = &"ouverture"
speaker = "Sacha"
text = "Tu sais... c'est mes parents. Ils se disputent tout le temps en ce moment. Je sais pas trop quoi faire, alors je fais style que ça me touche pas."
required_flags = Array[StringName]([])
forbidden_flags = Array[StringName]([])
sets_flags = Array[StringName]([])
grants_item_id = &""
grants_keyword_id = &""
