completes_quest_id = &""
triggers_glitch = false
auto_next_line_id = &""
choices = Array[ExtResource("2_sm4vp")]([SubResource("Resource_ydeat"), SubResource("Resource_kkncj")])

[sub_resource type="Resource" id="Resource_gyewi"]
script = ExtResource("1_dn25p")
line_id = &"ouverture_profonde"
speaker = "Sacha"
text = "...Partir, je crois. Loin. Mais je dis ça et j'ai même pas le courage de sortir de ma chambre certains jours. Alors bon."
required_flags = Array[StringName]([])
forbidden_flags = Array[StringName]([])
sets_flags = Array[StringName]([&"sacha/confiance_partagee", &"sacha/confiance_profonde"])
